# Cloudflare Pages response headers. Not served as a file — Pages consumes it.
#
# The script-src hash covers the one inline <script> on archive.html, which is
# emitted by src/render.py:update_archive. If you edit that script, recompute:
#   python -c "import re,hashlib,base64,pathlib;h=pathlib.Path('docs/archive.html').read_text(encoding='utf-8');b=re.search(r'<script>(.*?)</script>',h,re.S).group(1);print('sha256-'+base64.b64encode(hashlib.sha256(b.encode()).digest()).decode())"

